{
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "seed.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
